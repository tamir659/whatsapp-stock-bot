{
  "name": "whatsapp-stock-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute watchlist-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0001_init.sql",
    "db:migrate2:local": "wrangler d1 execute watchlist-db --local --file=migrations/0002_per_user_lists.sql",
    "db:migrate2:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0002_per_user_lists.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.5.0",
    "wrangler": "^4"
  }
}
