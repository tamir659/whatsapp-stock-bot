{
  "name": "whatsapp-stock-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute watchlist-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0001_init.sql",
    "db:migrate2:local": "wrangler d1 execute watchlist-db --local --file=migrations/0002_per_user_lists.sql",
    "db:migrate2:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0002_per_user_lists.sql",
    "db:migrate3:local": "wrangler d1 execute watchlist-db --local --file=migrations/0003_cron_status.sql",
    "db:migrate3:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0003_cron_status.sql",
    "db:migrate4:local": "wrangler d1 execute watchlist-db --local --file=migrations/0004_conversation_history.sql",
    "db:migrate4:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0004_conversation_history.sql",
    "db:migrate5:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0005_valid_tickers.sql",
    "db:migrate6:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0006_seed_valid_tickers.sql",
    "db:migrate7:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0007_allow_duplicate_tickers.sql",
    "db:migrate8:remote": "wrangler d1 execute watchlist-db --remote --file=migrations/0008_authorized_chats.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.5.0",
    "wrangler": "^4"
  }
}
